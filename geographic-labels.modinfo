<?xml version="1.0" encoding="utf-8"?>
<Mod id="tmt-geographic-labels" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_GEO_LABELS_NAME</Name>
        <Description>LOC_MOD_GEO_LABELS_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <SpecialThanks>Firaxis and the Civ modding community for the game, documentation, and sample mods; the many real-world atlases and gazetteers behind the period-accurate place names.</SpecialThanks>
        <Package>GeographicLabels</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <Version>1.7.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <!-- title is a base-game LOC the engine owns; it is not defined in this mod's ModText.xml -->
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- Game scope: the labels and the mini-map menu checkbox. High LoadOrder so the mini-map panel
             the checkbox is injected into already exists. -->
        <ActionGroup id="geo-labels-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item>text/en_us/PlaceText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/PlaceText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/PlaceText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/PlaceText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/PlaceText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/PlaceText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/PlaceText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/PlaceText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/PlaceText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/PlaceText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/PlaceText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/PlaceText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/geo-labels-layer.js</Item>
                    <Item>ui/geo-labels-toggle.js</Item>
                    <Item>ui/geo-labels-options.js</Item>
                    <Item>ui/geo-labels-rename.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/geo-labels-layer.js</Item>
                    <Item>ui/geo-labels-rename.js</Item>
                    <Item>ui/geo-labels-store.js</Item>
                    <Item>ui/geo-labels-toggle.js</Item>
                    <Item>ui/geo-labels-options.js</Item>
                    <Item>ui/geo-labels-utils.js</Item>
                    <Item>ui/geo-labels-format.js</Item>
                    <Item>ui/geo-labels-toponyms.js</Item>
                    <Item>ui/geo-labels-map.js</Item>
                    <Item>ui/geo-labels-water.js</Item>
                    <Item>ui/geo-labels-rivers.js</Item>
                    <Item>ui/geo-labels-categories.js</Item>
                    <Item>ui/geo-labels-compute.js</Item>
                    <Item>ui/geo-labels-providers.js</Item>
                    <Item>ui/geo-labels-l10n.js</Item>
                    <Item>ui/geo-labels-text.js</Item>
                    <Item>images/geo-labels-icon.svg</Item>
                    <Item>images/geo-labels-icon.png</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
        <!-- Shell scope: register the Options-screen entry for the main menu too. -->
        <ActionGroup id="geo-labels-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                    <Item locale="de_DE">text/de_de/ModText.xml</Item>
                    <Item locale="es_ES">text/es_es/ModText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
                    <Item locale="it_IT">text/it_it/ModText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/ModText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/geo-labels-options.js</Item>
                </UIScripts>
                <ImportFiles>
                    <Item>ui/geo-labels-options.js</Item>
                    <Item>ui/geo-labels-utils.js</Item>
                    <Item>ui/geo-labels-categories.js</Item>
                </ImportFiles>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
        <File>text/en_us/PlaceText.xml</File>
    </LocalizedText>
</Mod>
